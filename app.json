{
  "expo": {
    "name": "VolleyStats",
    "slug": "VolleyStats",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0C14"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0C14"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "VolleyStats",
      "shortName": "VolleyStats",
      "description": "Volleyball match tracking and analytics",
      "themeColor": "#A855F7",
      "backgroundColor": "#0A0C14",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font"
    ]
  }
}